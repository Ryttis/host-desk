{
    "name": "hostdesk/hostdesk",
    "description": "Authenticated municipal infrastructure inventory",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": "~8.4.0 || ~8.5.0",
        "ext-ctype": "*",
        "ext-iconv": "*",
        "ext-pdo_pgsql": "*",
        "ext-sodium": "*",
        "doctrine/dbal": "^4.3",
        "doctrine/doctrine-bundle": "^2.18",
        "doctrine/doctrine-migrations-bundle": "^3.4",
        "doctrine/orm": "^3.5",
        "easycorp/easyadmin-bundle": "^4.27",
        "scheb/2fa-bundle": "^8.0",
        "scheb/2fa-totp": "^8.0",
        "symfony/asset": "7.4.*",
        "symfony/asset-mapper": "7.4.*",
        "symfony/console": "7.4.*",
        "symfony/dotenv": "7.4.*",
        "symfony/expression-language": "7.4.*",
        "symfony/form": "7.4.*",
        "symfony/framework-bundle": "7.4.*",
        "symfony/lock": "7.4.*",
        "symfony/property-access": "7.4.*",
        "symfony/property-info": "7.4.*",
        "symfony/rate-limiter": "7.4.*",
        "symfony/runtime": "7.4.*",
        "symfony/security-bundle": "7.4.*",
        "symfony/security-csrf": "7.4.*",
        "symfony/translation": "7.4.*",
        "symfony/twig-bundle": "7.4.*",
        "symfony/validator": "7.4.*",
        "symfony/yaml": "7.4.*",
        "twig/extra-bundle": "^3.0",
        "twig/twig": "^3.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5",
        "symfony/browser-kit": "7.4.*",
        "symfony/css-selector": "7.4.*"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "symfony/runtime": true
        },
        "sort-packages": true
    },
    "scripts": {
        "test": "phpunit",
        "check": [
            "@php bin/console lint:container",
            "@php bin/console lint:yaml config",
            "@php bin/console lint:twig templates",
            "@php bin/console doctrine:schema:validate"
        ]
    },
    "conflict": {
        "symfony/clock": ">=8.0",
        "symfony/dom-crawler": ">=8.0",
        "symfony/error-handler": ">=8.0",
        "symfony/filesystem": ">=8.0",
        "symfony/finder": ">=8.0",
        "symfony/http-client": ">=8.0",
        "symfony/http-foundation": ">=8.0",
        "symfony/intl": ">=8.0",
        "symfony/mime": ">=8.0",
        "symfony/options-resolver": ">=8.0",
        "symfony/password-hasher": ">=8.0",
        "symfony/routing": ">=8.0",
        "symfony/security-core": ">=8.0",
        "symfony/stopwatch": ">=8.0",
        "symfony/string": ">=8.0",
        "symfony/twig-bridge": ">=8.0",
        "symfony/type-info": ">=8.0",
        "symfony/uid": ">=8.0",
        "symfony/var-dumper": ">=8.0",
        "symfony/var-exporter": ">=8.0"
    }
}
