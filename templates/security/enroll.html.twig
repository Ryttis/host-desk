{% extends 'base.html.twig' %}
{% block body %}
<h2>Set up your authenticator</h2>
<p>MFA is required before you can access inventory.</p>
<p>Add a time-based account in your authenticator: HostDesk, {{ app.user.userIdentifier }}. Enter this setup key manually:</p>
<p class="secret"><code>{{ secret }}</code></p>
<p>Use 6 digits, SHA-1, and a 30-second period. Keep this key private.</p>
{% if error %}<p class="error" role="alert">{{ error }}</p>{% endif %}
<form method="post">
<label for="code">Authenticator code</label><input id="code" name="code" inputmode="numeric" pattern="[0-9]{6}" autocomplete="one-time-code" required>
<input type="hidden" name="_csrf_token" value="{{ csrf_token('enroll') }}"><button>Confirm enrollment</button>
</form>
<p><a href="{{ logout_path() }}">Sign out</a></p>
{% endblock %}
