{% extends 'base.html.twig' %}
{% block body %}
<h2>Archive {{ entity }}</h2>
<p>This preserves the record and its history. It performs no action on any server. Archived records cannot be edited.</p>
{% if error %}<p class="error" role="alert">{{ error }}</p>{% endif %}
<form method="post"><input type="hidden" name="_token" value="{{ csrf_token('archive:' ~ type ~ ':' ~ id) }}"><button>Archive</button></form>
<p><a href="{{ path('admin') }}">Return to inventory</a></p>
{% endblock %}
