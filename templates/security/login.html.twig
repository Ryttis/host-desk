{% extends 'base.html.twig' %}
{% block body %}
<h2>Sign in</h2>
{% if app.request.query.has('enrolled') %}<p>MFA enrolled. Sign in with your password and authenticator code.</p>{% endif %}
{% if error %}<p class="error" role="alert">Sign-in failed. Check your credentials or try again later.</p>{% endif %}
<form method="post" action="{{ path('login') }}">
<label for="email">Email</label><input id="email" name="_username" type="email" value="{{ last_username }}" autocomplete="username" required autofocus>
<label for="password">Password</label><input id="password" name="_password" type="password" autocomplete="current-password" required>
<input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}"><button>Sign in</button>
</form>
<p>Individual accounts are created by your administrator.</p>
{% endblock %}
